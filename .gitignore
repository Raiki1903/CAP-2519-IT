# Dependencies
node_modules

# Build output
dist

# Keep environment variables out of version control
.env

# Prisma generated client (regenerate with `npm run prisma:generate`)
/generated/prisma

# Vite / tooling caches
.vite
*.log

# Personal data. Never commit these. (C-01, H-17, M-19)
scratch/backups/
pending_registrations.json

# Other env files (keep the example)
.env.*
!.env.example

# Agent and test output
.playwright-mcp/
coverage/

# Personal Claude Code settings (the shared settings.json stays tracked)
.claude/settings.local.json

# Database dumps dropped in the repo root by mistake
/*.sql
*.sql.gz
*.dump

# OS clutter
.DS_Store
Thumbs.db
