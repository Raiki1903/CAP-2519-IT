{
  "name": "adric-system",
  "private": true,
  "version": "1.0.0",
  "description": "Asset Management System for DLSU CCS AdRIC - combined frontend (Vite/React) + backend (Express/Prisma/MySQL) + analytics dashboard.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "tsx server/main.ts",
    "server:watch": "tsx watch server/main.ts",
    "dev:all": "concurrently -n FE,API -c blue,green \"npm run dev\" \"npm run server\"",
    "seed": "tsx test-user.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-tooltip": "1.1.8",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "form-data": "^4.0.6",
    "jsqr": "^1.4.0",
    "lucide-react": "0.487.0",
    "mailgun.js": "^13.3.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.18.1",
    "recharts": "^3.10.0",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.1.0",
    "prisma": "^7.9.1",
    "tailwindcss": "4.1.12",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.9.0": true,
    "@tailwindcss/oxide@4.1.12": true,
    "prisma@7.9.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
