# Copy this file to .env and fill in the values. Never commit .env.
# Variable NAMES only in this file. No real values, ever. (C-07)

# Database, read by prisma.ts
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Database, read by prisma.config.ts for Prisma CLI commands only.
# This is separate from the five variables above. Set both or the CLI fails
# while the server keeps working.
DATABASE_URL=

# Email. Optional: without these, the app runs and sends no mail.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

# Automated database backup. Optional.
# Leave empty to disable backups. If set, it must be an absolute path
# OUTSIDE this repository: backups are personal data. (C-01)
BACKUP_DIR=

# Web app: address of the backend, read by web/api/client.ts. Optional.
# Leave empty to use http://localhost:4000, which is what the app used before.
VITE_API_URL=
