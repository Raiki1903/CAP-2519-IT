# Copy this file to .env and fill in the values. Never commit .env.
# Variable NAMES only in this file. No real values, ever. (C-07)

# Database, read by server/config/env.ts. All five are required: the server
# stops at startup and names any that are missing. There are no defaults.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# Prisma CLI commands (migrate, diff) do NOT read this file. prisma.config.ts
# takes their database from PRISMA_TARGET_URL, set in the shell for one command
# only. Do not add PRISMA_TARGET_URL here: a command that names no database must
# stop, not reach CCS Cloud. How to set it: docs/guides/DATABASE-MIGRATIONS.md.
# DATABASE_URL is no longer read by anything; an old line in your .env is harmless.

# Session, read by server/config/env.ts. REQUIRED: the server stops at startup
# without it. At least 32 random characters, different on every machine and
# never shared. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=

# The web app's address, the only origin the API answers from a browser (CORS).
# Optional: leave empty for http://localhost:5173 (npm run dev). Open the app at
# exactly this address: http://127.0.0.1:5173 is a different origin.
WEB_ORIGIN=

# Email. Optional: without these, the app runs and sends no mail.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

# API tests only (npm test). A LOCAL MySQL 8.0 database whose name ends in
# _test, for example mysql://root:<password>@localhost:3306/AdRIC_DB_test.
# The tests refuse any other host or name. Never the CCS Cloud database.
# Setup steps: tests/README.md.
TEST_DATABASE_URL=

# Web app: address of the backend, read by web/api/client.ts. Optional.
# Leave empty to use http://localhost:4000, which is what the app used before.
VITE_API_URL=
